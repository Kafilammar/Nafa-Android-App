<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nafa" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/nafa_green</item>
        <item name="colorPrimaryDark">@color/nafa_green_dark</item>
        <item name="colorAccent">@color/nafa_green</item>
        <item name="android:colorAccent">@color/nafa_green</item>
        <item name="android:colorControlActivated">@color/nafa_green</item>
        <item name="android:textColorHighlight">#5500852B</item>
        <item name="android:windowBackground">@color/nafa_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Nafa.Splash" parent="Theme.Nafa">
        <item name="android:windowBackground">@color/nafa_green</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
